{
  "name": "@cms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "scripts": {
    "dev": "prisma generate && bun ../../scripts/parallel.mjs dev:schema dev:server",
    "dev:schema": "prisma generate --watch",
    "dev:server": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun --env-file=../../.env src/main.ts",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cms/content": "workspace:*",
    "@cms/sdk": "workspace:*",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "aws4fetch": "1.0.20",
    "elysia": "^1.4.30",
    "elysia-autoload": "1.7.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "^0.8.3",
    "meilisearch": "0.62.0",
    "nodemailer": "^10.2.0",
    "openid-client": "^6.8.8",
    "sharp": "^0.35.5",
    "web-push-neo": "^0.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "prisma": "^7.10.1"
  }
}
