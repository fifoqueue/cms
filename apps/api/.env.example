# Prisma CLI uses the mysql:// scheme for MariaDB.
DATABASE_URL=mysql://cms:cms@localhost:3306/cms
PORT=4000
# Uploaded plugin bundles are stored here (relative to apps/api).
PLUGINS_DIR=data/plugins
SESSION_TTL_HOURS=336
# Upper bound for any single plugin callback (activate, hook, slot, route).
PLUGIN_TIMEOUT_MS=3000

# OpenID Connect single sign-on (any standards-compliant provider). Off unless the first three are set.
# Secrets stay on the API server; the web app never sees them.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=cms
# OIDC_REDIRECT_URI=https://cms.example.com/admin/sso/callback
# OIDC_CLIENT_SECRET=
# client_secret_basic (default with a secret) | client_secret_post | none (public client, PKCE only)
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# OIDC_SCOPES=openid
# OIDC_NAME=Company SSO
# Required while SSO is on: at least 32 random characters, set to the same value on the web app.
# Only requests carrying it may state the browser address that per-client limits count by.
# OIDC_FRONTEND_SECRET=
# Sign-in requests pending at once (each expires after 10 minutes); further starts are refused.
# OIDC_MAX_PENDING_REQUESTS=1000
# Pending requests per client: one browser network (IPv4 address or IPv6 /64) or signed-in user.
# OIDC_MAX_PENDING_PER_CLIENT=10
# Sign-in starts per minute, checked first (HTTP 429) and kept per API process.
# OIDC_STARTS_PER_MINUTE=300
# OIDC_STARTS_PER_MINUTE_PER_CLIENT=10
# Provider subjects allowed to sign in as an existing administrator, without linking first.
# Accounts are never matched by the provider's email claim.
# OIDC_ALLOWED_SUBJECTS={"provider-subject-id":"admin@example.com"}
