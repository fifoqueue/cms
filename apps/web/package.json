{
  "name": "@cms/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/release.js",
    "preview": "vite preview",
    "start": "bun --no-env-file server.js",
    "prepare": "svelte-kit sync || echo ''",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker"
  },
  "dependencies": {
    "@cms/content": "workspace:*",
    "@cms/sdk": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "lean-qr": "2.7.4",
    "parse5": "^8.0.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.1",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "imports": {
    "#web-env": "./env-filter.js",
    "#web-release": "./scripts/release.js",
    "#web-test/*": "./test/*",
    "#web/*": "./src/*",
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
