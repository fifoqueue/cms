# Copy to .env at the repository root. The API reads every applicable value; the web launcher
# removes API-only secrets before loading the built app. Variables already in the environment win.
# Everything in this file is optional: the setup wizard stores the database connection and the
# admin area configures the site. Values set here override the defaults.

# Ports and listening addresses. Both servers accept connections from this machine only by
# default; put an https reverse proxy in front, or set a host such as 0.0.0.0.
# API_PORT=4000
# API_HOST=127.0.0.1
# WEB_PORT=3000
# WEB_HOST=127.0.0.1
# Where the web app reaches the API (default http://127.0.0.1:<API_PORT>).
# CMS_API_URL=http://127.0.0.1:4000
# Largest request the web app accepts (uploads, imports).
# BODY_SIZE_LIMIT=64M
# adapter-node behind a proxy: https://svelte.dev/docs/kit/adapter-node#Environment-variables
# ORIGIN=https://cms.example.com
# Visitor addresses come from the proxy's X-Forwarded-For by default. XFF_DEPTH is the number of
# trusted proxies in front of the web server (2 for e.g. Cloudflare → nginx). Set ADDRESS_HEADER
# to another header (CF-Connecting-IP, X-Real-IP) if your proxy sends that instead; an empty value
# uses the connection address (no proxy).
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# API
# Prisma CLI uses the mysql:// scheme for MariaDB.
# DATABASE_URL=mysql://cms:cms@localhost:3306/cms
# Uploaded plugin bundles are stored here (relative to apps/api).
# PLUGINS_DIR=data/plugins
# SESSION_TTL_HOURS=336
# Upper bound for any single plugin callback (activate, hook, slot, route).
# PLUGIN_TIMEOUT_MS=3000
# Uploaded media (relative to apps/api) and the largest upload in megabytes.
# MEDIA_DIR=data/media
# MEDIA_MAX_MB=20
# How often background tasks (scheduled publishing, email, search sync, cleanups) are checked.
# SCHEDULER_INTERVAL_MS=5000
# Optional: the web app pairs itself automatically once an administrator signs in. Set a value
# (at least 32 random characters) to skip that; both servers read it from this file.
# CMS_FRONTEND_SECRET=
# At least 32 random characters. Encrypts stored secrets (SMTP password, captcha and search keys)
# and signs preview links; without it a key is generated in data/secret.key (back it up).
# CMS_SECRET_KEY=
# During deliberate rotation, keep the old key here until queued jobs drain and stored secrets
# have been saved again with the new active key.
# CMS_SECRET_KEY_PREVIOUS=
# Read-only additions to Settings → Outbound access. JSON array of
# {"service":"oidc|search|smtp|webhook","host":"...","port":443,"addresses":["10.0.0.4/32"]}.
# CMS_EGRESS_ALLOWLIST=[]

# OpenID Connect single sign-on is normally set in Settings → Single sign-on. Setting the first three
# here replaces the stored provider list with provider id "environment".
# The stored passwordLogin policy still applies; only the emergency override below forces it on.
# Secrets stay on the API server; the web app never sees them.
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=cms
# OIDC_REDIRECT_URI=https://cms.example.com/admin/sso/callback
# OIDC_CLIENT_SECRET=
# client_secret_basic (default with a secret) | client_secret_post | none (public client, PKCE only)
# OIDC_CLIENT_AUTH_METHOD=client_secret_basic
# OIDC_SCOPES=openid
# OIDC_NAME=Company SSO
# Last-resort recovery: force password sign-in on, without changing stored SSO-only policy.
# CMS_ALLOW_PASSWORD_LOGIN=false
# Older name of CMS_FRONTEND_SECRET.
# OIDC_FRONTEND_SECRET=
# Pending requests per store (SSO and step-based sign-in each use these bounds).
# Each sign-in expires after 10 minutes; rotation does not extend its lifetime.
# OIDC_MAX_PENDING_REQUESTS=1000
# Pending requests per client: one browser network (IPv4 address or IPv6 /64) or signed-in user.
# OIDC_MAX_PENDING_PER_CLIENT=10
# Sign-in starts per minute, checked first (HTTP 429) and kept per API process.
# OIDC_STARTS_PER_MINUTE=300
# OIDC_STARTS_PER_MINUTE_PER_CLIENT=10
# Provider subjects allowed to sign in as an existing administrator, without linking first.
# Accounts are never matched by the provider's email claim.
# OIDC_ALLOWED_SUBJECTS={"provider-subject-id":"admin@example.com"}
